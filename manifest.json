{
  "manifest_version": 3,
  "name": "masterG",
  "version": "1.0.0",
  "description": "Boost your productivity and enhance your browser experience. Privacy-focused, open source, and no data tracking.",
  "author": "masterG Team",
  "homepage_url": "https://github.com/Vibe-coder-ss/masterG",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "masterG - Productivity Booster"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "offscreen",
    "system.display",
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content/content.js", "content/clipboard-capture.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
